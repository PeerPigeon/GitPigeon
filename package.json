{
  "name": "gitpigeon",
  "version": "0.13.45",
  "description": "Real-time, peer-to-peer synchronization for native Git repositories",
  "type": "module",
  "bin": {
    "git-pigeon": "./bin/git-pigeon.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "PEERPIGEON.lock.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "node --check bin/git-pigeon.js && node --test"
  },
  "engines": {
    "node": ">=20.12"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "node-pty": "^1.1.0",
    "peerpigeon": "https://github.com/PeerPigeon/PeerPigeon/archive/adbc15f142ba426fe93dd703e3d693f5bf39a53f.tar.gz",
    "werift": "0.24.4",
    "ws": "8.21.3",
    "yjs": "^13.6.32"
  },
  "overrides": {
    "freertc": "git+https://github.com/draeder/freertc.git#e4d5b6293599bb29d0b2a959aae8844a167d147f"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6"
  }
}
